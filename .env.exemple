# Configuração do site na VPS. O scripts/instalar-site.sh copia este arquivo
# para .env na primeira vez; é no .env que você preenche, e ele não vai para o
# git nem é apagado quando o site atualiza.

# A porta em que o site escuta. Em branco, o site é gerado mas não sobe no
# pm2 até você preencher e rodar o instalador de novo.
PORT=

# Em branco fica 127.0.0.1, atrás do nginx. Sem nginx na frente, 0.0.0.0
# expõe direto.
HOST=

# Desliga a telemetria anônima do Next.js.
NEXT_TELEMETRY_DISABLED=1
